# Copy to estimator/.env (gitignored) so autostart needs no arguments.
# A real environment variable always overrides a line here.

# Required. 16+ characters. Must match GROK_GATEWAY_TOKEN on the Portainer stack.
ESTIMATOR_TOKEN=change-me-to-something-long-and-random

# Bind address. Use this machine's tailnet IP so the container can reach it
# (find it with `tailscale ip -4`). Leave as 127.0.0.1 for local-only testing.
ESTIMATOR_HOST=127.0.0.1
ESTIMATOR_PORT=8787

# Which CLIs to try, in order. The first usable answer wins.
# Claude leads by default: lighter on your plan, faster, and it leaves the
# fallback room inside the time budget. Swap to grok,claude to reverse it.
ESTIMATOR_ORDER=claude,grok

# Leave unset to auto-detect the usual install locations.
# GROK_BIN=C:/Users/you/.grok/bin/grok.exe
# CLAUDE_BIN=C:/Users/you/.local/bin/claude.exe

# Do not raise this to a bigger model. See the README.
CLAUDE_MODEL=claude-haiku-5-5

# Timing. The app gives up at 45s, so the total stays under that.
# ESTIMATOR_BUDGET_MS=40000
# ESTIMATOR_TIMEOUT_MS=35000
# ESTIMATOR_RESERVE_MS=9000

# Automatic backups. The journal lives on a machine you do not own; this pulls a
# copy here on a timer. Leave BACKUP_URL unset to turn it off.
BACKUP_URL=https://friend-server.tail9878f8.ts.net
BACKUP_PASSPHRASE=the-same-passphrase-the-app-uses
# BACKUP_DIR defaults to estimator/backups
BACKUP_EVERY_HOURS=12
BACKUP_KEEP=30
