# Copy to .env, or paste these as environment variables in the Portainer stack editor.

# Required. The shared passphrase both of you type to open the journal.
# Use something long; changing it signs every device out.
APP_PASSPHRASE=change-me

# Optional. Enables Grok macro estimates on the Meal screen.
# Without it the app still works and macros are entered by hand.
XAI_API_KEY=
XAI_MODEL=

# Optional. Host port to publish the app on.
ATHX_PORT=3000
